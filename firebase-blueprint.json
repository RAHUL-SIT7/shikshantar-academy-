{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and role metadata",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher", "student"] },
        "adminTier": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending", "blocked", "rejected"] },
        "class": { "type": "string" },
        "studentId": { "type": "string" }
      },
      "required": ["role"]
    },
    "RemitBill": {
      "title": "RemitBill",
      "description": "Institutional fee bill invoice document",
      "type": "object",
      "properties": {
        "billNo": { "type": "string" },
        "studentId": { "type": "string" },
        "studentUid": { "type": "string" },
        "academicYear": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["UNPAID", "PARTIAL", "PAID", "VOID"] }
      },
      "required": ["billNo", "studentId", "totalAmount"]
    },
    "CashLedgerEntry": {
      "title": "CashLedgerEntry",
      "description": "Physical cash desk receipt / voucher transaction entry",
      "type": "object",
      "properties": {
        "receiptNo": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["PAYMENT", "REFUND", "ADVANCE_IN", "ADVANCE_OUT", "CANCELLATION"] },
        "academicYear": { "type": "string" }
      },
      "required": ["receiptNo", "amount", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Collection storing application user profiles and access roles"
    },
    "/remitBills/{billId}": {
      "schema": { "$ref": "#/entities/RemitBill" },
      "description": "Collection storing student remit bills and invoices"
    },
    "/cash_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/CashLedgerEntry" },
      "description": "Collection storing cash ledger records for administrative finance desk"
    }
  }
}
