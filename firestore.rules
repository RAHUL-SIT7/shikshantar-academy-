rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // SECURITY HELPER FUNCTIONS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        (hasUserDoc() && getUserData().role == 'admin')
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        (hasUserDoc() && getUserData().role == 'teacher')
      );
    }

    function isStudent() {
      return isSignedIn() && (
        request.auth.token.role == 'student' ||
        (hasUserDoc() && getUserData().role == 'student')
      );
    }

    function isUserOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStudentOwner(studentId) {
      return isSignedIn() && (
        request.auth.uid == studentId ||
        (resource != null && (
          resource.data.studentId == request.auth.uid ||
          resource.data.studentUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )) ||
        (hasUserDoc() && getUserData().studentId == studentId)
      );
    }

    // ==========================================
    // USER PROFILES & AUTHENTICATION
    // ==========================================

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() || (
        isUserOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'adminTier', 'status', 'active'])
      );
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && (isStudentOwner(studentId) || isTeacher() || isAdmin());
      allow write: if isAdmin();
    }

    // ==========================================
    // PUBLIC FORMS & SUBMISSIONS
    // ==========================================

    match /admissions/{admissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contact_enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /alumni_submissions/{alumniId} {
      allow create: if true;
      allow read: if isAdmin() || (resource != null && resource.data.status == 'approved');
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // PUBLIC / SCHOOL DATA & NOTICES
    // ==========================================

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /school_data/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // ACADEMIC & EXAMINATION RECORDS
    // ==========================================

    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /results/{resultId} {
      allow read: if isSignedIn() && (isAdmin() || isTeacher() || (resource != null && isStudentOwner(resource.data.studentId)));
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /resultSummary/{summaryId} {
      allow read: if isSignedIn() && (isAdmin() || isTeacher() || (resource != null && isStudentOwner(resource.data.studentId)));
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /results_secure/{studentId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);

      match /records/{recordId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);
        allow write: if isAdmin();
      }
    }

    match /userCalendars/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      match /{subpath=**} {
        allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      }
    }

    // ==========================================
    // FINANCIAL RECORDS & CASH LEDGER
    // Strict isolation: Zero teacher access, Student read-own only, Admin write
    // ==========================================

    match /remitBills/{billId} {
      allow read: if isAdmin() || (isSignedIn() && !isTeacher() && resource != null && isStudentOwner(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /billItems/{itemId} {
      allow read: if isAdmin() || (isSignedIn() && !isTeacher() && resource != null && isStudentOwner(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /studentFees/{feeId} {
      allow read: if isAdmin() || (isSignedIn() && !isTeacher() && resource != null && isStudentOwner(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && !isTeacher() && resource != null && isStudentOwner(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /cash_ledger/{entryId} {
      // Institutional physical cash ledger: Restricted exclusively to administrators
      allow read, write: if isAdmin();
    }

    match /student_advances/{advanceId} {
      allow read: if isAdmin() || (isSignedIn() && !isTeacher() && resource != null && isStudentOwner(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /refund_records/{refundId} {
      allow read: if isAdmin() || (isSignedIn() && !isTeacher() && resource != null && isStudentOwner(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /excess_payment_requests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && !isTeacher() && resource != null && isStudentOwner(resource.data.studentId));
      allow create: if isAdmin() || isStudent();
      allow update, delete: if isAdmin();
    }

    match /ledger_audit_logs/{logId} {
      // Immutable append-only audit trail: zero update or deletion
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /document_sequences/{sequenceId} {
      // Atomic sequential receipt & bill numbering locks
      allow read, write: if isAdmin();
    }

    match /annual_fee_locks/{lockId} {
      allow read, write: if isAdmin();
    }

    match /admission_fee_locks/{lockId} {
      allow read, write: if isAdmin();
    }

    match /billing_month_locks/{lockId} {
      allow read, write: if isAdmin();
    }

    match /archived_student_fees/{archiveId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // STAFF & TEACHER SALARIES
    // ==========================================

    match /salary_structures/{structureId} {
      allow read, write: if isAdmin();
    }

    match /salary_records/{recordId} {
      allow read: if isAdmin() || (isTeacher() && resource != null && resource.data.teacherId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /salary_requests/{requestId} {
      allow read: if isAdmin() || (isTeacher() && resource != null && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // DEFAULT CLOSED FALLBACK
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
